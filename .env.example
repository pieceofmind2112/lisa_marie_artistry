# Copy to .env.local for local testing. On Vercel, add these under Project > Settings > Environment Variables.

# --- Quick try-out: no Google or Twilio needed. Stores data in .data/demo.json on your computer.
DEMO_MODE=true

# --- Sign-in (Google OAuth client ID, "Web application" type)
GOOGLE_CLIENT_ID=
# Who may sign in, comma separated
ALLOWED_EMAILS=
# Any long random string (e.g. `openssl rand -base64 32`)
SESSION_SECRET=

# --- Google service account (the app's robot user for the Sheet and Calendar)
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Paste the private_key from the JSON key file, keeping the \n sequences, inside double quotes
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
# From the sheet URL: docs.google.com/spreadsheets/d/<THIS PART>/edit
GOOGLE_SHEET_ID=
# Lisa's calendar ID, usually just her Gmail address
GOOGLE_CALENDAR_ID=
# Optional. Defaults to the calendar's own time zone.
APP_TIMEZONE=

# --- Texting (Twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Either a Messaging Service SID (recommended once 10DLC is approved) or a From number
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_FROM_NUMBER=
# "live" sends real texts. Anything else only previews them.
SMS_MODE=preview
# Lisa's own number, included in texts so clients reply to her, not to Twilio
BUSINESS_PHONE=
BUSINESS_NAME=LisaMarie Artistry

# --- Daily reminder job (Vercel sends this automatically as a Bearer token)
CRON_SECRET=
